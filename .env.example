# Copy to .env.local and fill with your Supabase project values.
# Dashboard: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# If these are unset, the app runs in offline mode (local device storage + PIN).
# For production deployment, set both variables on your host (Vercel, Netlify, etc.).

# Ask Sika AI assistant
# This key should be added to your Vercel project environment variables.
# Create key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
